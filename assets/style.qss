/* --- Global Base --- */
QWidget {
    background: #262421;
    color: #bababa;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #262421;
}

/* --- Buttons --- */
QPushButton {
    background-color: #312e2b;
    color: #ffffff;
    border: 1px solid #403d39;
    border-radius: 3px;
    padding: 5px 15px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #383531;
    border: 1px solid #504d48;
}

QPushButton:pressed {
    background-color: #21201d;
}

QPushButton:disabled {
    background-color: #262421;
    color: #555;
    border: 1px solid #333;
}

/* Specific styling for Small Icon Buttons */
QPushButton#SmallIconButton {
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 4px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#SmallIconButton:hover {
    background-color: #312e2b;
    border: 1px solid #403d39;
}

QPushButton#SmallIconButton:pressed {
    background-color: #21201d;
}

/* --- Docks --- */
QDockWidget {
    color: #8b8987;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 11px;
    border: 1px solid #312e2b;
}

QDockWidget::title {
    background: #21201d;
    text-align: left;
    padding: 4px;
}

QDockWidget {
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background: #262421;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #403d39;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #504d48;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- TabWidget --- */
QTabWidget::pane {
    border-top: 1px solid #312e2b;
}

QTabBar::tab {
    background: #21201d;
    color: #8b8987;
    padding: 6px 15px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #262421;
    color: #ffffff;
    border-bottom: 2px solid #e6912c;
}

/* --- Input Controls --- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background: #312e2b;
    color: #ffffff;
    border: 1px solid #403d39;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #e6912c;
}

/* --- Menus --- */
QMenuBar {
    background: #21201d;
    color: #bababa;
    padding: 2px;
}

QMenuBar::item:selected {
    background: #312e2b;
    border-radius: 3px;
}

QMenu {
    background: #262421;
    color: #bababa;
    border: 1px solid #403d39;
}

QMenu::item:selected {
    background: #312e2b;
    color: #ffffff;
}

/* --- ToolBar --- */
QToolBar {
    background: #21201d;
    border: none;
    spacing: 5px;
    padding: 3px;
}

/* --- Chessboard Editor Specific --- */
QWidget#chessboard_editor QPushButton {
    background: #312e2b;
    border: 1px solid #403d39;
    min-width: 50px;
    min-height: 50px;
    padding: 0px;
}

QWidget#chessboard_editor QPushButton:checked {
    background: #403d39;
    border: 1px solid #e6912c;
}
