/* --- Global Base --- */
QWidget {
    background: #262421;
    color: #bababa;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #262421;
}

/* --- Buttons --- */
QPushButton {
    background-color: #312e2b;
    color: #ffffff;
    border: 1px solid #403d39;
    border-radius: 3px;
    padding: 5px 15px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #383531;
    border: 1px solid #504d48;
}

QPushButton:pressed {
    background-color: #21201d;
}

QPushButton:disabled {
    background-color: #262421;
    color: #555;
    border: 1px solid #333;
}

/* Specific styling for Small Icon Buttons */
QPushButton#SmallIconButton {
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 4px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#SmallIconButton:hover {
    background-color: #312e2b;
    border: 1px solid #403d39;
}

QPushButton#SmallIconButton:pressed {
    background-color: #21201d;
}

/* --- Docks --- */
QDockWidget {
    color: #bababa;
    font-weight: 600;
    font-size: 11px;
    border: 1px solid #383531;
}

QDockWidget::title {
    background: #21201d;
    text-align: left;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0px;
    padding-bottom: 0px;
    border-bottom: 1px solid #312e2b;
    color: #d1d5db;
}


/* --- ScrollBar --- */
QScrollBar:vertical {
    background: #262421;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #403d39;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #504d48;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- TabWidget & Dock Tabs --- */
QTabWidget::pane {
    border-top: 1px solid #312e2b;
}

QTabBar {
    background: transparent;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab {
    background: #21201d;
    color: #8b8987;
    padding: 2px 10px;
    min-height: 14px;
    border-top: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-radius: 3px;
    margin-right: 2px;
    margin-top: 1px;
    margin-bottom: 1px;
}

QTabBar::tab:hover {
    background: #312e2b;
    color: #ffffff;
}

QTabBar::tab:selected {
    background: #2a2825;
    color: #ffffff;
    border-bottom: 2px solid #e6912c;
}

/* --- Chessboard Surrounding Area --- */
#boardCentralWidget, #boardGroup {
    background: #262421;
}

#fenContainer {
    background: transparent;
}

/* --- Input Controls --- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDateEdit, QDateTimeEdit {
    background: #312e2b;
    color: #ffffff;
    border: 1px solid #403d39;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #e6912c;
}

/* --- Menus --- */
QMenuBar {
    background: #21201d;
    color: #bababa;
    padding: 2px;
}

QMenuBar::item:selected {
    background: #312e2b;
    border-radius: 3px;
}

QMenu {
    background: #262421;
    color: #bababa;
    border: 1px solid #403d39;
}

QMenu::item:selected {
    background: #312e2b;
    color: #ffffff;
}

/* --- ToolBar --- */
QToolBar {
    background: #21201d;
    border: none;
    spacing: 5px;
    padding: 3px;
}

/* --- Chessboard Editor Specific --- */
QWidget#chessboard_editor QPushButton {
    background: #312e2b;
    border: 1px solid #403d39;
    min-width: 50px;
    min-height: 50px;
    padding: 0px;
}

QWidget#chessboard_editor QPushButton:checked {
    background: #403d39;
    border: 1px solid #e6912c;
}

/* --- Tables (QTableView & QTableWidget) --- */
QTableView, QTableWidget, QTreeView, QTreeWidget {
    background-color: #262421;
    alternate-background-color: #2c2926;
    color: #e2e8f0;
    gridline-color: #383531;
    border: 1px solid #3d3a36;
    border-radius: 4px;
    selection-background-color: #1e3a5f;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QTableWidget::item, QTreeView::item, QTreeWidget::item {
    padding: 3px 6px;
    outline: none;
    border: none;
}

QTableView::item:hover, QTableWidget::item:hover, QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #33302c;
}

QTableView::item:selected, QTableWidget::item:selected, QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #1e3a5f;
    color: #ffffff;
    outline: none;
    border: none;
}

QTableView::item:focus, QTableWidget::item:focus, QTreeView::item:focus, QTreeWidget::item:focus {
    outline: none;
    border: none;
}

QTableView::item:selected:focus, QTableWidget::item:selected:focus, QTreeView::item:selected:focus, QTreeWidget::item:selected:focus {
    background-color: #1e3a5f;
    color: #ffffff;
    outline: none;
    border: none;
}

QHeaderView {
    background-color: #141312;
    border: none;
}

QHeaderView::section {
    background-color: #141312;
    color: #f8fafc;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #383531;
    border-bottom: 1px solid #383531;
    font-weight: bold;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #242220;
    color: #ffffff;
}

QTableCornerButton::section {
    background-color: #141312;
    border: none;
    border-right: 1px solid #383531;
    border-bottom: 1px solid #383531;
}

/* --- List Widget --- */
QListWidget {
    background-color: #262421;
    color: #bababa;
    border: 1px solid #403d39;
    border-radius: 3px;
    outline: none;
}

QListWidget::item {
    padding: 6px;
}

QListWidget::item:selected {
    background-color: #e6912c;
    color: #ffffff;
}

/* --- Calendar Popup --- */
QCalendarWidget {
    border: 1px solid #403d39;
    border-radius: 3px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #21201d;
}

QCalendarWidget QToolButton {
    color: #bababa;
    background-color: transparent;
    border: none;
    font-weight: bold;
}

QCalendarWidget QToolButton:hover {
    background-color: #312e2b;
    border-radius: 3px;
}

QCalendarWidget QMenu {
    background-color: #262421;
    color: #bababa;
}

QCalendarWidget QSpinBox {
    background-color: #312e2b;
    color: #ffffff;
    border: 1px solid #403d39;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #262421;
    color: #bababa;
    selection-background-color: #e6912c;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #403d39;
}

