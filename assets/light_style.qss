/* --- Global Base (Light Blue / White Theme) --- */
QWidget {
    background: #f8fafc;
    color: #0f172a;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #f8fafc;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 5px 15px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border: 1px solid #94a3b8;
    color: #1e3a8a;
}

QPushButton:pressed {
    background-color: #e2e8f0;
    border: 1px solid #64748b;
}

QPushButton:checked {
    background-color: #dbeafe;
    color: #1d4ed8;
    border: 1px solid #93c5fd;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}

/* Specific styling for Small Icon Buttons */
QPushButton#SmallIconButton {
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 4px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#SmallIconButton:hover {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
}

QPushButton#SmallIconButton:pressed {
    background-color: #e2e8f0;
}

/* --- Docks --- */
QDockWidget {
    color: #334155;
    font-weight: 600;
    font-size: 11px;
    border: 1px solid #cbd5e1;
}

QDockWidget::title {
    background: #f1f5f9;
    text-align: left;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0px;
    padding-bottom: 0px;
    border-bottom: 1px solid #e2e8f0;
    color: #1e293b;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    background: #f8fafc;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    background: #f8fafc;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

/* --- TabWidget & Dock Tabs --- */
QTabWidget::pane {
    border: 1px solid #cbd5e1;
    background: #ffffff;
}

QTabBar {
    background: transparent;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab {
    background: #f1f5f9;
    color: #475569;
    padding: 6px 14px;
    min-height: 20px;
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    border-radius: 4px;
    margin-right: 3px;
    margin-top: 2px;
    margin-bottom: 2px;
}

QTabBar::tab:hover {
    background: #e2e8f0;
    color: #1e3a8a;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
    font-weight: 600;
}

/* --- Chessboard Surrounding Area --- */
#boardCentralWidget, #boardGroup {
    background: #e2e8f0;
}

#fenContainer {
    background: transparent;
}

/* --- Input Controls --- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDateEdit, QDateTimeEdit {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #2563eb;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #e2e8f0;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

/* --- Menus --- */
QMenuBar {
    background: #f8fafc;
    color: #0f172a;
    padding: 2px;
    border-bottom: 1px solid #e2e8f0;
}

QMenuBar::item:selected {
    background: #e2e8f0;
    color: #1e3a8a;
    border-radius: 3px;
}

QMenu {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
}

QMenu::item:selected {
    background: #2563eb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e2e8f0;
    margin: 4px 8px;
}

/* --- ToolBar --- */
QToolBar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    spacing: 4px;
    padding: 3px 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    color: #0f172a;
}

QToolButton:hover {
    background: #e2e8f0;
    border: 1px solid #cbd5e1;
}

QToolButton:pressed {
    background: #cbd5e1;
}

QToolButton:checked {
    background: #dbeafe;
    border: 1px solid #93c5fd;
    color: #1e3a8a;
}

/* --- Tables & List Views --- */
QTableWidget, QTableView, QTreeWidget, QTreeView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #0f172a;
    gridline-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

QTableWidget::item, QTableView::item, QTreeWidget::item, QTreeView::item {
    padding: 5px;
}

QTableWidget::item:selected, QTableView::item:selected, QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QHeaderView {
    background-color: #e2e8f0;
    border: none;
}

QHeaderView::section {
    background-color: #e2e8f0;
    color: #0f172a;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #cbd5e1;
    border-right: 1px solid #cbd5e1;
    font-weight: bold;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #cbd5e1;
    color: #0f172a;
}

QTableCornerButton::section {
    background-color: #e2e8f0;
    border: none;
    border-bottom: 1px solid #cbd5e1;
    border-right: 1px solid #cbd5e1;
}

QListWidget {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px;
}

QListWidget::item:hover {
    background-color: #f1f5f9;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
    font-weight: 500;
}

/* --- Splitters --- */
QSplitter::handle:horizontal {
    background-color: #e2e8f0;
    width: 2px;
}

QSplitter::handle:vertical {
    background-color: #e2e8f0;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #2563eb;
}

/* --- GroupBox --- */
QGroupBox {
    font-weight: bold;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background-color: #f8fafc;
}

/* --- Status Bar --- */
QStatusBar {
    background: #f1f5f9;
    color: #334155;
    border-top: 1px solid #e2e8f0;
    font-size: 12px;
}

/* --- Calendar Popup --- */
QCalendarWidget {
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #ffffff;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #f1f5f9;
    border-bottom: 1px solid #e2e8f0;
}

QCalendarWidget QToolButton {
    color: #0f172a;
    background-color: transparent;
    border: none;
    font-weight: bold;
}

QCalendarWidget QToolButton:hover {
    background-color: #e2e8f0;
    border-radius: 3px;
}

QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #0f172a;
}

QCalendarWidget QSpinBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #94a3b8;
}


